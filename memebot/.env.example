# ---- Acceso al dashboard (OBLIGATORIO: cambia la contraseña) ----
DASHBOARD_PASSWORD=cambia-esto
SESSION_SECRET=cadena-aleatoria-larga

# ---- Modo ----
# paper = simulación con dinero ficticio (por defecto, recomendado empezar aquí)
# live  = dinero real. Requiere LIVE_CONFIRM=YES_I_ACCEPT_THE_RISK y WALLET_PRIVATE_KEY
MODE=paper
LIVE_CONFIRM=

# ---- Wallet SOLO para modo live (usa una wallet NUEVA con poco saldo) ----
# Clave privada en base58 (la que exporta Phantom). NUNCA la subas a GitHub.
WALLET_PRIVATE_KEY=
# RPC de Solana. El público va lento; mejor uno gratuito de Helius/QuickNode/Alchemy
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ---- Capital y riesgo (en SOL) ----
PAPER_START_BALANCE_SOL=5
POSITION_SIZE_SOL=0.05
MAX_OPEN_POSITIONS=12
MAX_DAILY_LOSS_SOL=0.6
